<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/dji_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DJI SDK: DISCONNECTED"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aircraft_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aircraft: DISCONNECTED"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/udp_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UDP: NOT CONFIGURED"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        
        <EditText
            android:id="@+id/ip_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Windows IP"
            android:text="192.168.1.100" />
            
        <EditText
            android:id="@+id/port_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Port"
            android:text="8000" />
    </LinearLayout>

    <Button
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START UDP"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/telemetry_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="No Telemetry"
        android:textSize="16sp"
        android:fontFamily="monospace" />

</LinearLayout>
